# GRIDSEC Platform Configuration

# Database Configuration (SQLite default for local development, PostgreSQL when specified)
DATABASE_URL=sqlite:///gridsec.db

# Server Configuration
PORT=8000
HOST=0.0.0.0
DEBUG=True

# CORS Configuration
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8080","http://127.0.0.1:8080"]

# Security & Provenance
SECRET_KEY=gridsec_production_secret_key_change_in_production
DATA_PROVENANCE_DEFAULT=PROJECT_DATASET
